{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "togather",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // run_worker_first 只列 /api/*。
  //
  // 千万不要把 "/e/*" 加进来 —— 加了之后，朋友在微信里点开活动链接
  // （一次完整的页面加载，不是前端路由跳转）会被 Worker 截住，
  // 而 Worker 没有 /e/* 的路由，于是返回一个 JSON 404，整个产品在最关键
  // 的一步直接报废。
  //
  // 二期要做微信分享卡片（OG 标签注入）时再加回来，但那时必须同时在
  //  Worker 里实现「不认识的路由放行给静态资源」。
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "togather",
      "database_id": "PLACEHOLDER",
      "migrations_dir": "migrations"
    }
  ]
}
