# 依赖
node_modules/

# 构建产物
dist/
.wrangler/
.output/

# 本地环境变量（含密钥，绝不提交）
.dev.vars
.dev.vars.*
# 但模板要留着 —— 换台电脑克隆下来得知道要配哪些变量。
# 少了这条否定规则，README 里那句 `cp .dev.vars.example .dev.vars`
# 会找不到源文件，而且失败得莫名其妙（明明文件就在本地目录里）。
!.dev.vars.example
*.local

# 设计草稿与可视化伴侣产物
.superpowers/

# 部署时临时生成的配置备份（scripts/build-pages.mjs 用，用完就还原）
wrangler.worker.jsonc

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*

# 截图脚本的产物（scripts/shoot.mjs）
.shots/
